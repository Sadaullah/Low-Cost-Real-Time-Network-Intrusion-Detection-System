# /etc/suricata/threshold.config - NetGuard Pi
# Enabled in suricata.yaml with: threshold-file: /etc/suricata/threshold.config
# Every entry is explained in docs/rule-tuning-log.md

# 2026-10-05: RFB (VNC) protocol anomaly fires on the admin's own RealVNC Viewer
# (RealVNC uses a proprietary security type). Suppress ONLY for the admin laptop.
suppress gen_id 1, sig_id 2233001, track by_either, ip fe80::342c:7d12:feae:49be
