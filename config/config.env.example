# /etc/fyp-ids/config.env  -  FYP-IDS settings (chmod 600, owned by root)

SENSOR_NAME=netguard-pi
EVE_PATH=/var/log/suricata/eve.json
DB_PATH=/var/lib/fyp-ids/alerts.db
RETENTION_DAYS=30

# --- Telegram (recommended: free, instant on your phone) ---
# 1. In Telegram, chat with @BotFather -> /newbot -> copy the token
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates  and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-mail (optional; for Gmail create an "App password") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# Notify for severity 1 (high) and 2 (medium); 3 = also low
NOTIFY_MAX_SEVERITY=2
# Same rule + same attacker: at most one message per this many seconds
NOTIFY_COOLDOWN_SEC=60

# --- Web dashboard ---
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-to-a-strong-password
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# --- Active response / auto-blocking (ip_blocker.py) ---
# Ban a source IP after BLOCK_THRESHOLD alerts within BLOCK_WINDOW_SEC,
# then automatically unban it after BLOCK_DURATION_SEC.
BLOCK_IFACE=eth0
BLOCK_THRESHOLD=5
BLOCK_WINDOW_SEC=30
BLOCK_DURATION_SEC=600
# Only act on severity <= this (1 = high, 2 = medium)
BLOCK_MIN_SEVERITY=2
# Never ban these IPs / networks (admin laptop, Wi-Fi management, localhost)
BLOCK_WHITELIST=127.0.0.1,192.168.1.0/24,192.168.10.1
# Set to 1 to only LOG what would be blocked (no iptables changes) for testing
BLOCK_DRY_RUN=0
