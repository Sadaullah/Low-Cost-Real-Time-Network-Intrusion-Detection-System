# =====================================================================
#  NetGuard Pi - team's first custom rules (version 2 - tuned 2026-10-05, see docs/rule-tuning-log.md)
#  Written by the team before the FYP-IDS rule set (rules/local.rules).
#  Live location on the Pi: /var/lib/suricata/rules/local.rules
#  SID range 9000001-9000099 (no clash with 1000001-1000099)
#  Tuning notes are recorded in docs/rule-tuning-log.md
# =====================================================================
alert icmp any any -> $HOME_NET any (msg:"NetGuard ICMP ping to lab host"; itype:8; threshold: type limit, track by_src, count 1, seconds 60; classtype:misc-activity; sid:9000001; rev:2;)
alert tcp any any -> $HOME_NET any (msg:"NMAP SYN Scan Detected"; flow:stateless; flags:S,12; threshold: type both, track by_src, count 5, seconds 3; sid:9000002; rev:2;)
alert tcp any any -> $HOME_NET any (msg:"NMAP Port Scan Detected"; flags:S; threshold: type both, track by_src, count 10, seconds 5; sid:9000003; rev:2;)
alert tcp any any -> $HOME_NET any (msg:"NMAP Service Scan Detected"; flow:to_server; flags:S; threshold: type both, track by_src, count 20, seconds 10; sid:9000004; rev:2;)
alert udp any any -> $HOME_NET any (msg:"NMAP UDP Scan Detected"; threshold: type both, track by_src, count 5, seconds 3; sid:9000005; rev:2;)
