# =====================================================================
#  NetGuard Pi - team's first custom rules (version 1)
#  Written by the team before the FYP-IDS rule set (rules/local.rules).
#  Live location on the Pi: /var/lib/suricata/rules/local.rules
#  SID range 9000001-9000099 (no clash with 1000001-1000099)
#  Tuning notes are recorded in docs/rule-tuning-log.md
# =====================================================================
alert icmp any any -> any any (msg:"TEST ICMP Detected"; sid:9000001; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"NMAP SYN Scan Detected"; flow:stateless; flags:S,12; threshold: type threshold, track by_src, count 5, seconds 3; sid:9000002; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"NMAP Port Scan Detected"; flags:S; threshold: type threshold, track by_src, count 10, seconds 5; sid:9000003; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"NMAP Service Scan Detected"; flow:to_server; flags:S; threshold: type threshold, track by_src, count 20, seconds 10; sid:9000004; rev:1;)
alert udp any any -> $HOME_NET any (msg:"NMAP UDP Scan Detected"; threshold: type threshold, track by_src, count 5, seconds 3; sid:9000005; rev:1;)
